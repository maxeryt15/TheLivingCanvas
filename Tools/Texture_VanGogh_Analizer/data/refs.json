    "field": "trigal / pasto: trazos cortos verticales o diagonales, ritmo denso",
    "cypress": "llama vertical: trazos curvos que suben y se retuercen",
    "foliage": "copa de arbol / arbusto: comas curvas en abanico",
    "leaf_blade": "hojas largas en cuchilla (lirios), contorno marcado",
    "petal": "petalos y corolas, impasto grueso radial",
    "scattered_dash": "fondo de toques sueltos que orbitan una forma (retratos): ideal para paredes",
    "water": "reflejos verticales quebrados sobre agua",
    "ground": "suelo / camino: trazos horizontales o que siguen la perspectiva",
    "roof": "tejas: toques cortos en hileras",
    "flower_dabs": "manchas de flores pequenas, toques redondeados",
    "hatch": "rayado direccional que modela volumen (sombrero, cara)"
  },
