  m_Name: Commission_OttilieSwirlSunflower
  m_EditorClassIdentifier: TheLivingCanvas::TheLivingCanvas.Data.CommissionDefinition
  crop: {fileID: 11400000, guid: 0ecc6f8237d80d34b96096d748dbfbb3, type: 2}
  variantId: 
  minQuality: 1
  requestLines:
  - 'Darling, I have a new obsession: swirls! Great, rolling, dizzy brushstrokes
    that make the whole canvas feel alive.'
  - Paint me a sunflower in the Swirl style, Good quality or better. I want to feel
    the wind in those petals.
  - No Swirl style yet? The shop sells it, darling. Go and treat yourself, then come
    straight back to me!
  thanksLines:
  - Look at it move! Every stroke is a little whirlwind. I could stare at it for
    hours.
  - You have a wild hand, darling, and I mean that as the highest of compliments.
  rewardCoins: 100
  rewardXp: 60
  rewardPigment: {fileID: 0}
  rewardPigmentAmount: 0
