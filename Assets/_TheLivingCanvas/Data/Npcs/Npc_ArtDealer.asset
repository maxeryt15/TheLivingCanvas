  m_Script: {fileID: 11500000, guid: 934c68d71dbf39c47bb2843c2b430878, type: 3}
  m_Name: Npc_ArtDealer
  m_EditorClassIdentifier: TheLivingCanvas::TheLivingCanvas.Data.NpcDefinition
  displayName: Bastien Marlowe
  greetingLines:
  - 'Hm. Let me guess: you paint, you grow, and now you would like to be paid. Bastien
    Marlowe. I appraise things.'
  - I buy originals only. Seeds and copies are of no interest to me. I pay by crop,
    quality, rarity and canvas, and I can tell all four at a glance.
  - Show me something worth my time.
  seasonLines:
  - Spring. Everyone paints blossoms. Few paint them well.
  - Summer. Bright colours sell. Muddy ones don't.
  - Autumn. Collectors grow sentimental this time of year. Good for business.
  - Winter. Fewer buyers, sharper eyes. Bring me your best.
  commissions: []
