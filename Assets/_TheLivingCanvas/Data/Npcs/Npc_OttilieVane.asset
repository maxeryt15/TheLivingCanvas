  m_Script: {fileID: 11500000, guid: 934c68d71dbf39c47bb2843c2b430878, type: 3}
  m_Name: Npc_OttilieVane
  m_EditorClassIdentifier: TheLivingCanvas::TheLivingCanvas.Data.NpcDefinition
  displayName: Ottilie Vane
  greetingLines:
  - Oh! A new face among my favourite walls. I'm Ottilie Vane, and I collect colours
    the way other people collect teaspoons.
  - Rare pigments make my heart flutter. And paintings that grow? Darling, I would
    cross three counties for one.
  - Keep your brushes wet and your garden wilder than is sensible. The best colours
    always sprout where nobody planned them.
  - I may have a request or two for you, once you have settled in. Do come and chat
    again soon!
  commissions:
  - {fileID: 11400000, guid: e0c01c690bbde444bb7195528bdd7eaa, type: 2}
